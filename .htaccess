RewriteEngine On

# 1. Affiliate redirect (must be first)
RewriteRule ^play/?$ https://f9j3l.bemobtrcks.com/go/a4effd45-e048-46dc-964c-eb226c19b5bc?site=drawnudeorg [R=301,L]

# 2. HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 3. www -> non-www
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# 4. /index.html -> /
RewriteRule ^index\.html$ / [R=301,L]

# 5. Multiple slashes
RewriteCond %{REQUEST_URI} ^(.*)/{2,}(.*)$
RewriteRule ^ https://drawnude.org/%1%2 [L,R=301]

Header always set X-Frame-Options "SAMEORIGIN"
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'"

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 1 hour"
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>

ErrorDocument 404 /404.html

<FilesMatch "\.htaccess">
  Order Allow,Deny
  Deny from all
</FilesMatch>
